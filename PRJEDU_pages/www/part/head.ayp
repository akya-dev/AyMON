<!doctype html><%
// The top of every page. The including page sets 'title' (and 'refresh',
// seconds; 0 = none) BEFORE its include line: an include is spliced into
// the page when it is translated, so it sees the page's variables.
-%>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<% if (refresh) { -%>
<meta http-equiv="refresh" content="<%= refresh %>">
<% } -%>
<title><%= title %> - PRJEDU_pages</title>
<link rel="stylesheet" href="/style.css">
</head>
<body>
<header>
  <b>Tank farm</b>
  <nav><a href="/">Overview</a> <a href="/access.ayp">Access</a> <a href="/api.ayp">API</a></nav>
</header>
<main>
