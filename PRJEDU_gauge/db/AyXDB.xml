<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- =====================================================================
     PRJEDU_gauge - AyMON example: read an analog pressure gauge with a
     camera, in Python, and treat what it reads as a measurement.

     One document, GAU/S00:
       a compressor tank whose pressure nobody can measure except with the
       old dial gauge on its side, a "camera" that photographs that gauge
       once a second (Python draws the picture: no camera needed), a reader
       that finds the needle in the picture (Python, numpy), and a web page
       that shows the picture, the reading and how wrong it is.

     Needs a 64-bit Python 3.11 with numpy - the README says how - and the
     engine's picture module AyLIB_vision (beside AyXDB, in ../bin), loaded
     below: it encodes the picture for the page (IMG.encode) and measures
     it (IMG.stats).

     Run:  run.bat,  then open  http://127.0.0.1:8091/
     ===================================================================== -->
<xdb id="XDB" xdb_lib="AyLIB_vision" xdb_lib_req="1" xdb_log="4" log_cfg="0x39C0" log_lnk="%PRJ%/log/XDB.log"
     sta="0x0300" tid="S01">
	<config>
		<doc id="GAU/S00" sta="0x0300" src="%DB%/db_GAU.xml" desc="a gauge, a camera and a reader" />
	</config>
	<data>
	</data>
</xdb>
