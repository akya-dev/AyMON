<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- =====================================================================
     PRJEDU_vision - AyMON example: a camera inspects bottles on a filling
     line, in the engine, with no Python and no camera to buy.

     One document, VIS/S00:
       a camera that is a CONNECTION (CON.cam) - here it plays back the
       pictures in ..\frames, a conveyor at ten frames a second; one
       attribute turns it into your webcam - two more views of the same
       camera (link:), each with its own rate and size, an inspection in
       JScript with the engine's image functions (IMG.*), and a web page
       with the live picture, the last bottle inspected and the rejects.

     One engine module, AyLIB_vision, beside AyXDB in ../../../bin, loaded below:
       the camera: CON.cam, PRO.cam, CAM.list()
       the image functions: IMG.hsv, inrange, label, count, ..

     Run:  run.bat,  then open  http://127.0.0.1:8113/
     ===================================================================== -->
<xdb id="XDB" xdb_lib="AyLIB_vision" xdb_lib_req="1" xdb_log="4" log_cfg="0x39C0" log_lnk="%PRJ%/log/XDB.log"
     sta="0x0300" tid="S01">
	<config>
		<doc id="VIS/S00" sta="0x0300" src="%DB%/db_VIS.xml" desc="a filling line, a camera and an inspection" />
	</config>
	<data>
	</data>
</xdb>
