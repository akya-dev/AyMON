<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>PRJHW_lock</title>
<style>
body{font:15px system-ui,sans-serif;margin:0;background:#f4f5f7;color:#222}
main{max-width:640px;margin:0 auto;padding:16px}
h1{font-size:20px;margin:8px 0 4px}p{margin:4px 0 14px;color:#555}
.lcd{background:#2d4a9a;color:#dfe8ff;font:20px/1.4 ui-monospace,Consolas,monospace;padding:10px 14px;border-radius:6px;white-space:pre;min-height:56px;overflow:hidden}
.row{display:flex;gap:16px;flex-wrap:wrap;margin:14px 0;align-items:flex-start}
.card{flex:1 1 150px;background:#fff;border:1px solid #ddd;border-radius:6px;padding:10px}
.card b{display:block;font-size:22px}
#pad{display:none;grid-template-columns:repeat(4,52px);gap:6px}
#pad button{height:44px;font-size:18px}
button{font:inherit;padding:6px 10px;margin:2px;border:1px solid #bbb;border-radius:5px;background:#fff;cursor:pointer}
#w{display:none;margin-top:8px}
</style></head><body><main>
<h1>A lock with a keypad and a card reader</h1>
<p>Code 1234, then #. * clears. The known card opens it too. Three wrong codes block it for 30 s.</p>
<div class="lcd" id="lcd"></div>
<div class="row">
 <div class="card">Bolt<b id="b">-</b></div>
 <div class="card">Buzzer<b id="z">-</b></div>
 <div class="card">Reader<b id="c">-</b></div>
</div>
<div id="pad"></div>
<div id="w"><button onclick="go('card')">Hold the known card</button><button onclick="go('stranger')">Hold another card</button><button onclick="go('nocard')">Take it away</button></div>
</main><script>
var keys='123A456B789C*0#D',pad=document.getElementById('pad');
for(var i=0;i<16;i++){(function(k){var b=document.createElement('button');b.textContent=k;b.onclick=function(){go(k)};pad.appendChild(b)})(keys[i])}
function show(j){
 document.getElementById('lcd').textContent=j.l1+'\n'+j.l2;
 document.getElementById('b').textContent=(j.open?'open':'shut')+' ('+j.bolt+'°)';
 document.getElementById('z').textContent=j.buz?'sounding':'quiet';
 document.getElementById('c').textContent=j.card?'a card':'no card';
 pad.style.display=j.sim?'grid':'none';
 document.getElementById('w').style.display=j.sim?'block':'none';
}
function go(x){fetch('/state.ayp'+(x?'?a='+encodeURIComponent(x):'')).then(function(r){return r.json()}).then(show)}
setInterval(function(){go()},500);go();
</script></body></html>
