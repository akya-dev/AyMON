<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- =====================================================================
     HIS/S00 - the history document.

     The same three moving parts as PRJEDU_sqlite:

       <con id="CN_SQL">    the database. Its con_host is EMPTY here: the
                            script fills it in xdb_init, from the entry
                            with id="ConnStr" in AyXDB.xml.
       <var id="T_READ">    a timer: produce a reading, write it (script).
       <list id="L_RECENT"> a QUERY THAT BECOMES ELEMENTS.

     WHY xdb_init. A document starts in a fixed order:
         <script> elements are parsed      (the functions exist)
         xdb_init runs                     <-  main.init(evt) here
         every element's xdb_fnc runs      (CN_SQL is created and dials)
         xdb_start runs                    <-  main.start(evt) here
     A value written into CN_SQL/@con_host in xdb_init is what CON.sql
     reads when it is created a moment later. Written in xdb_start, it
     would come too late: the connection would already be dialling an
     empty string.
     ===================================================================== -->
<xdb id="HIS/S00" xdb_lib="AyPRO" xdb_log="4" log_cfg="0x39C0" log_lnk="%PRJ%/log/HIS.log"
     xdb_init="main.init(evt);" xdb_start="main.start(evt);"
     sta="0x0300" sta_typ="0x142" thr_wrk="0" thr_per="100"
     xdb_acl="0xFFFFFFF1">
	<config>
		<script id="main" xdb_fnc="[SCR.prs]" src="%DB%/db_HIS.js" language="JScript"
		        sta="0x0303" sta_typ="0x142"></script>
	</config>

	<data>
		<!-- The thread the timers below run on. -->
		<thr id="TH_MAIN" xdb_fnc="[THR.cre]" thr_per="100" thr_wrk="1"
		     sta="0x0303" sta_typ="0x142" sta_fnc="[THR.sta]"/>

		<!-- THE DATABASE.
		     xdb_fnc="[CON.sql,PRO.sql]"
		                   CON.sql is the SQL connection class for EVERY
		                   driver. Which driver answers is decided by the
		                   connection string: DRIVER=SQLite3i goes to the
		                   embedded SQLite, anything no driver claims goes
		                   to ODBC. (CON.odbc / PRO.odbc are the older names
		                   of the same pair and still work.)
		     con_host      THE CONNECTION STRING, handed to the driver as
		                   written - no macro expansion. Filled by
		                   main.init(); at most 255 characters.
		     con_pool="2"  two connections kept open and handed out as
		                   needed. SQL.attach() borrows one.
		     con_rct       seconds between attempts while the database
		                   cannot be reached. A server that comes up after
		                   AyMON is found on its own.
		     pro_tmo       how long one statement may take, in SECONDS. -->
		<con id="CN_SQL" xdb_fnc="[CON.sql,PRO.sql]" desc="the plant history database"
		     con_host=""
		     con_mod="CLIENT" con_pool="2" con_ses="0" con_clr="1"
		     con_tmo="5" con_comdly="1" con_rcvdly="100" con_rct="5"
		     con_keeptmo="0" con_idletmo="0"
		     pro_role="MASTER" pro_tmo="10" pro_try="1" pro="1" pro_typ="0xC412" pro_fnc="[]"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>

		<!-- A QUERY THAT BECOMES ELEMENTS. Write SQL into @qry and SQL.qry
		     runs it on qry_con; every row becomes an <item> child, every
		     column an attribute named after the column. Read it back as
		     id('L_RECENT')/item[1]/@val - from script, a web front end,
		     a replication peer.

		     TRAP: do NOT select a column called 'id' - in AyMON 'id' is
		     the element's identifier. Alias it. -->
		<list id="L_RECENT" desc="the last five readings, as elements"
		      qry="" qry_typ="0x1401" qry_fnc="[SQL.qry]" qry_max="10" qry_con="CN_SQL"
		      sta="0x0303" sta_typ="0x0142"/>

		<!-- Once a second: produce a reading and write it.
		     cnt  the sequence number of the last reading STORED. Set from
		          the database when it is first reached (max(seq)), so a
		          restart carries on where the last run stopped.
		     rdy  1 once the table has been found or created. Until then
		          every tick tries again - the database may come up after
		          the engine. -->
		<var id="T_READ" xdb_fnc="[XDB.evt]" sta="0x0303" sta_typ="0x142" sta_fnc="[EVT.sta]"
		     evt="" evt_typ="0x1201" evt_thr="TH_MAIN" evt_per="1" evt_dly="1" evt_syn="0"
		     evt_cfg="0x4042" evt_fnc="[main.read]"
		     cnt="0" cnt_typ="0x5104" rdy="0" rdy_typ="0x5104" desc="sampling timer"/>

		<!-- Every ten seconds: ask the database what it has.
		     evt_cfg 0x4042: the 0x4000 bit fires the FIRST time at start +
		     evt_dly (6 s) instead of start + evt_per + evt_dly (16 s); the
		     sampler above uses it too. Without it a periodic timer waits one
		     whole period before its first firing. -->
		<var id="T_SUM" xdb_fnc="[XDB.evt]" sta="0x0303" sta_typ="0x142" sta_fnc="[EVT.sta]"
		     evt="" evt_typ="0x1201" evt_thr="TH_MAIN" evt_per="10" evt_dly="6" evt_syn="0"
		     evt_cfg="0x4042" evt_fnc="[main.summary]" desc="reporting timer"/>

		<!-- ================================================================
		     WHAT THE PAGE SHOWS - written by db_HIS.js, published to the page
		       NOW     the reading just written
		       STATS   what the database says, every ten seconds (JSON)
		       RECENT  L_RECENT's rows, as one JSON value
		       FIND    the page's search: it writes a tag here (the one
		               thing it may write - its own xdb_acl), main.find
		               (val_typ 0x1401: the 0x1000 bit is what makes
		               val_fnc run)
		               counts that tag's rows with the tag BOUND, and
		       FOUND   the answer (JSON)
		     ================================================================ -->
		<var id="NOW"    sta="0x0303" val="0"  val_typ="0x0308" val_unt="C" desc="the last reading"/>
		<var id="STATS"  sta="0x0303" val=""   val_typ="0x0401" desc="count, min, max, mean, attack-shaped rows, NULL test - JSON"/>
		<var id="RECENT" sta="0x0303" val=""   val_typ="0x0401" desc="the last five rows - JSON"/>
		<var id="FIND"   sta="0x0303" val=""   val_typ="0x1401" xdb_acl="0xFFFFFFF3"
		     val_fnc="[main.find]" desc="a tag to look for - written by the page"/>
		<var id="FOUND"  sta="0x0303" val=""   val_typ="0x0401" desc="how many rows carry it - JSON"/>

		<!-- ================================================================
		     THE PAGE - http://127.0.0.1:8107/  (only from this computer)
		     CN_WEB serves www/; CN_LIVE is MQTT inside a WebSocket on the
		     same port (/mqtt) and publishes this document: a new
		     subscription gets the current values at once (retain), and
		     every change after that.
		     The page reads everything and writes one thing, FIND (its own
		     xdb_acl); xdb_acl="0xFFFFFFF1" on the document gives a Guest (role
		     0, a page that did not log in) read and nothing else.
		     ================================================================ -->
		<con id="CN_WEB" xdb_fnc="[CON.tcp,PRO.http]" desc="the page"
		     con_host="127.0.0.1" con_port="8107" con_mod="SERVER" con_ses="8" con_acl="127.0.0.1"
		     con_tmo="5" con_clr="1" con_rcvlen="8192" con_keeptmo="0" con_idletmo="60"
		     pro_role="SLAVE" pro_tmo="5" pro_try="1" pro="" pro_typ="0xD441" pro_fnc="[]"
		     pro_http_root="%PRJ%/www" pro_http_index="index.html"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>

		<con id="CN_LIVE" xdb_fnc="[CON.ws,PRO.mqtt]" desc="the live values for the page"
		     con_host="#CN_WEB" con_port="/mqtt" con_mod="SERVER" con_ses="4" con_acl="127.0.0.1"
		     con_tmo="5" con_clr="1" con_keeptmo="120.0" con_idletmo="-1"
		     pro_role="SLAVE" pro_tmo="5" pro_try="1" pro="1" pro_typ="0xC412" pro_fnc="[]"
		     pro_cid="S01_HISW" pro_nid="S00" pro_subqos="0"
		     pro_pfx="+/+" pro_getsfx="" pro_setsfx="set" pro_pubsfx="pub"
		     pro_pubqos="0" pro_pubrtn="0"
		     pro_retain="1" pro_retain_adr="//var" pro_retain_atr="val"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>
	</data>
</xdb>
