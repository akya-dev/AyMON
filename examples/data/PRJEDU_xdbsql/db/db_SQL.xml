<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- =====================================================================
     SQL/S00 - the history table, the SQL connections, the ports.

       CN_HIS      SQLite, log/plant.db: table his (tim, doc, rid, val), a
                   reading of every point every 2 s. pro_sql_xql="1": XDB
                   SQL may read it (sql() from role Engineer up, the named
                   queries below for whom their xdb_acl lets)
       CN_XQL      XDB SQL itself: the built-in driver 'xdb'. doc= are the
                   documents a query sees without naming one, sql= the one
                   database a query may take in
       HIS_LAST    \  named queries: the SQL is HERE, a caller gives only
       HIS_STATS   /  the name and the values, which are bound, never pasted

       Q           the page's query: a Guest writes XDB SQL to @qry,
                   SQL.qry runs it on CN_XQL WITH THE WRITER'S ROLE, the
                   rows come back as JSON in @qry_out, a refusal in @qry_err
       Q_X         the other way: SQLite's own SQL with a table of the
                   tree inside, xdb('SELECT .. FROM "LINE/*".io') AS x;
                   main.view runs it every 5 s, XIN shows the rows

       CN_PG       PostgreSQL wire protocol, 127.0.0.1:15432, role Engineer
       CN_PGM      the same, 127.0.0.1:15433, role Monitor, read only
       CN_WEB      the page, http://127.0.0.1:8119/  (CN_LIVE: its values)
     ===================================================================== -->
<xdb id="SQL/S00" xdb_lib="AyPRO" xdb_log="4" log_cfg="0x39C0" log_lnk="%PRJ%/log/SQL.log"
     xdb_start="main.start(evt);" sta="0x0300" sta_typ="0x142" thr_wrk="0" thr_per="100"
     xdb_acl="0xFFFFFFF1">
	<config>
		<script id="main" xdb_fnc="[SCR.prs]" src="%DB%/db_SQL.js" language="JScript"
		        sta="0x0303" sta_typ="0x142"></script>

		<!-- A query element: synchronous (0x1401: the rows are there when the
		     write returns), the rows as JSON in qry_out (qry_jsn: no <item> is
		     made), the reason of a refusal in qry_err, 500 rows at most.
		     qry_con is the connection that runs the text.
		     cls_Q, the page's: qry_out / qry_err are 0x8401, PUBLISHED AT EVERY
		     RUN and never stored - the page gets an answer even when it is the
		     same as the last one (a stored value written again unchanged is no
		     change, and nothing would be sent).
		     cls_QS, the script's: stored, main.view reads them back.
		     xdb_acl on cls_Q, not on Q: the class DEFINES qry, and the element
		     that defines an attribute decides who may write it. 0xFFFFFFF3 =
		     a Guest may read and write; every other role, everything. -->
		<tlst id="cls_Q" xdb_acl="0xFFFFFFF3" qry="" qry_typ="0x1401" qry_fnc="[SQL.qry]" qry_con="CN_XQL" qry_max="500"
		      qry_out_typ="0x8401" qry_jsn="1" qry_err_typ="0x8401" qry_cnt="" qry_cnt_typ="0x8401"
		      sta_typ="0x0142"/>
		<tlst id="cls_QS" qry="" qry_typ="0x1401" qry_fnc="[SQL.qry]" qry_con="CN_HIS" qry_max="500"
		      qry_out="" qry_jsn="1" qry_err="" qry_err_typ="0x0401"
		      sta_typ="0x0142"/>
	</config>

	<data>
		<thr id="TH_MAIN" xdb_fnc="[THR.cre]" thr_per="100" thr_wrk="1"
		     sta="0x0303" sta_typ="0x142" sta_fnc="[THR.sta]"/>

		<!-- the history table (the engine needs AyPRO_sqlite beside it) -->
		<con id="CN_HIS" xdb_fnc="[CON.sqlite,PRO.sql]" desc="the history table"
		     con_host="%PRJ%/log/plant.db"
		     con_mod="CLIENT" con_ses="0" con_clr="1" con_tmo="5" con_rct="2"
		     con_keeptmo="0" con_idletmo="0"
		     pro_role="MASTER" pro_tmo="10" pro_try="1" pro="1" pro_typ="0xC412" pro_fnc="[]"
		     pro_sql_xql="1"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>

		<!-- XDB SQL: the documents of the two lines and this one; CN_HIS is the
		     only database a query may take in (sql() / sqlq()); 5000 rows at most -->
		<con id="CN_XQL" xdb_fnc="[CON.sql,PRO.sql]" desc="XDB SQL over the tree"
		     con_host="xdb:doc=LINE/*,SQL/S00;sql=CN_HIS;max=5000"
		     con_mod="CLIENT" con_ses="2" con_clr="1" con_tmo="5" con_rct="2"
		     con_keeptmo="0" con_idletmo="0"
		     pro_role="MASTER" pro_tmo="10" pro_try="1" pro="1" pro_typ="0xC412" pro_fnc="[]"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>

		<!-- ================================================================
		     NAMED QUERIES. The SQL is the engineer's, a caller names it and
		     gives the values: SELECT * FROM sqlq('HIS_LAST', 'L1_PT1', 5) h.
		     The values are bound to the ?s, never written into the text.
		     xdb_acl decides who may run one (here: everybody, the page's
		     Guest too); raw sql('CN_HIS', ..) needs an Engineer.
		     ================================================================ -->
		<sqlq id="HIS_LAST" xdb_acl="0xFFFFFFF1" sqlq_con="CN_HIS" sqlq_prm="2" sqlq_max="100"
		      desc="the last readings of a point: rid, how many"
		      sqlq_sql="SELECT tim, rid, val FROM his WHERE rid = ? ORDER BY tim DESC LIMIT ?"/>
		<sqlq id="HIS_STATS" xdb_acl="0xFFFFFFF1" sqlq_con="CN_HIS" sqlq_prm="1"
		      desc="every point over the last minutes: how many readings, the lowest, the highest, the mean"
		      sqlq_sql="SELECT rid, COUNT(*) AS n, ROUND(MIN(val), 2) AS lo, ROUND(MAX(val), 2) AS top, ROUND(AVG(val), 2) AS mean FROM his WHERE tim &gt;= datetime('now', 'localtime', '-' || ? || ' minutes') GROUP BY rid"/>

		<!-- the page's query: a Guest may write @qry (cls_Q's xdb_acl) -->
		<list id="Q" xdb_cls="cls_Q" sta="0x0303" xdb_acl="0xFFFFFFF3"
		      desc="the page's XDB SQL, run with the page's role"/>
		<!-- SQLite's own SQL with a table of the tree in it (main.view) -->
		<list id="Q_X" xdb_cls="cls_QS" sta="0x0303"
		      desc="SQLite's query, xdb() inside"/>

		<!-- every 2 s: a value for every point, into the tree and into his -->
		<var id="T_SAMPLE" xdb_fnc="[XDB.evt]" sta="0x0303" sta_typ="0x142" sta_fnc="[EVT.sta]"
		     evt="" evt_typ="0x1201" evt_thr="TH_MAIN" evt_per="2" evt_dly="1" evt_syn="0"
		     evt_cfg="0x0042" evt_fnc="[main.sample]" desc="the readings"/>
		<!-- every 5 s: Q_X, for the page -->
		<var id="T_VIEW" xdb_fnc="[XDB.evt]" sta="0x0303" sta_typ="0x142" sta_fnc="[EVT.sta]"
		     evt="" evt_typ="0x1201" evt_thr="TH_MAIN" evt_per="5" evt_dly="3" evt_syn="0"
		     evt_cfg="0x0042" evt_fnc="[main.view]" desc="SQLite's query for the page"/>

		<!-- what the page shows besides its own query: JSON, published -->
		<var id="XIN"  sta="0x0303" val="" val_typ="0x0401" desc="Q_X's rows"/>
		<var id="XSQL" sta="0x0303" val="" val_typ="0x0401" desc="Q_X's text and its error"/>

		<!-- ================================================================
		     POSTGRESQL. A client connects as to a PostgreSQL server; the
		     database name is a document ("SQL/S00", "LINE/L1"), a table is an
		     element name. No login here (only from this computer): the port
		     gives the role. pro_pg_doc = the documents a session may read,
		     pro_pg_sql = the databases its queries may take in.
		       psql "host=127.0.0.1 port=15432 user=eng dbname=SQL/S00"
		       python pg_try.py "SELECT id, desc, val FROM \"LINE/*\".io"
		     ================================================================ -->
		<con id="CN_PG" xdb_fnc="[CON.tcp,PRO.pgwire]" desc="PostgreSQL clients, role Engineer"
		     con_host="127.0.0.1" con_port="15432" con_mod="SERVER" con_ses="4" con_acl="127.0.0.1" con_role="6"
		     thr_wrk="2" thr_per="50" con_tmo="5" con_comdly="0" con_rct="0" con_clr="1" con_rcvlen="65536"
		     con_keeptmo="0" con_idletmo="300"
		     pro_role="SLAVE" pro_tmo="20" pro_try="1"
		     pro_pg_doc="LINE/*,SQL/S00" pro_pg_sql="CN_HIS" pro_pg_tmo="20"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>
		<con id="CN_PGM" xdb_fnc="[CON.tcp,PRO.pgwire]" desc="PostgreSQL clients, role Monitor, read only"
		     con_host="127.0.0.1" con_port="15433" con_mod="SERVER" con_ses="4" con_acl="127.0.0.1" con_role="2"
		     thr_wrk="2" thr_per="50" con_tmo="5" con_comdly="0" con_rct="0" con_clr="1" con_rcvlen="65536"
		     con_keeptmo="0" con_idletmo="300"
		     pro_role="SLAVE" pro_tmo="20" pro_try="1"
		     pro_pg_doc="LINE/*,SQL/S00" pro_pg_sql="CN_HIS" pro_pg_tmo="20" pro_pg_read="1"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>

		<!-- THE PAGE - http://127.0.0.1:8119/ (only from this computer) -->
		<con id="CN_WEB" xdb_fnc="[CON.tcp,PRO.http]" desc="the page"
		     con_host="127.0.0.1" con_port="8119" con_mod="SERVER" con_ses="8" con_acl="127.0.0.1"
		     con_tmo="5" con_clr="1" con_rcvlen="8192" con_keeptmo="0" con_idletmo="60"
		     pro_role="SLAVE" pro_tmo="5" pro_try="1" pro="" pro_typ="0xD441" pro_fnc="[]"
		     pro_http_root="%PRJ%/www" pro_http_index="index.html"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>

		<con id="CN_LIVE" xdb_fnc="[CON.ws,PRO.mqtt]" desc="the page's values and its query"
		     con_host="#CN_WEB" con_port="/mqtt" con_mod="SERVER" con_ses="4" con_acl="127.0.0.1"
		     con_tmo="5" con_clr="1" con_keeptmo="120.0" con_idletmo="-1"
		     pro_role="SLAVE" pro_tmo="5" pro_try="1" pro="1" pro_typ="0xC412" pro_fnc="[]"
		     pro_cid="S01_XQL" pro_nid="S00" pro_subqos="0"
		     pro_pfx="+/+" pro_getsfx="" pro_setsfx="set" pro_pubsfx="pub"
		     pro_pubqos="0" pro_pubrtn="0"
		     pro_retain="1" pro_retain_adr="//var" pro_retain_atr="val"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>
	</data>
</xdb>
