<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- =====================================================================
     ROB/S00 - the robot: a six-axis collaborative arm, simulated.

     It is built after a Universal Robots UR5e and speaks two of the
     interfaces a UR controller offers - the ones a cell controller or a
     PLC usually uses:

       THE DASHBOARD SERVER (TCP 29999). One text line per command, one
       text line back: "power on" - "Powering on", "load pick_place.urp" -
       "Loading program: /programs/pick_place.urp", "play" - "Starting
       program", "robotmode" - "Robotmode: RUNNING" ... The replies are
       the ones UR's own client library expects. A new connection is
       greeted first: "Connected: Universal Robots Dashboard Server".

       THE MODBUS TCP SERVER (here 1504; a real controller uses 502). The
       robot's state as holding registers, at the addresses UR publishes:
         128..135  general purpose registers - a PLC writes, the robot
                   program reads, and the other way round
         270..275  joint positions, mrad        (base .. wrist 3)
         280..285  joint speeds, mrad/s
         400..405  tool position: x y z in 0.1 mm, rx ry rz in mrad
       Negative values are 16-bit two's complement.

     THE ARM. Six joints with the UR5e's Denavit-Hartenberg parameters; the
     tool position is worked out from the joints (forward kinematics, in
     main.fk) the way the controller does. Motion is joint by joint, all
     joints arriving together, at up to 60 deg/s times the speed register.

     THE PROGRAMS are data (PROGRAMS, a JSON list of steps), run by
     main.run: movej to a waypoint, wait for a register, set a register,
     close or open the gripper, wait. pick_place.urp waits for the cell to
     say a part is ready (register 128), takes it, answers (register 131),
     puts it down, counts (register 129) and starts again.

     SAFETY. Two things in the world stop the arm, as they would a real
     one - and the page has a button for each:
       BUMP  someone walks into the arm: PROTECTIVE STOP. The program
             pauses; 'unlock protective stop' is refused for 5 s after the
             stop, then 'play' resumes.
       DOOR  the cell's guard door opens: SAFEGUARD STOP while it is open.
             The program pauses; close the door and 'play' again.
     These two are the world, not the controller: no xdb_acl here.
     ===================================================================== -->
<xdb id="ROB/S00" xdb_lib="AyPRO" xdb_log="4" log_cfg="0x39C0" log_lnk="%PRJ%/log/ROB.log"
     xdb_start="main.start(evt);" sta="0x0300" sta_typ="0x142" thr_wrk="0" thr_per="100">
	<config>
		<script id="main" xdb_fnc="[SCR.prs]" src="%DB%/db_ROB.js" language="JScript"
		        sta="0x0303" sta_typ="0x142"></script>
	</config>

	<data>
		<thr id="TH_ROB" xdb_fnc="[THR.cre]" thr_per="50" thr_wrk="0"
		     sta="0x0303" sta_typ="0x142" sta_fnc="[THR.sta]"/>

		<!-- ================================================================
		     THE DASHBOARD SERVER - text lines on TCP 29999
		     ================================================================ -->
		<con id="CN_DASH" xdb_fnc="[CON.tcp,PRO.raw]" desc="dashboard server (TCP 29999)"
		     con_host="127.0.0.1" con_port="29999" con_mod="SERVER" con_acl="127.0.0.1"
		     con_way="FULL" con_ses="4" con_tmo="5" con_clr="0" con_rcvlen="1024"
		     con_keeptmo="0" con_idletmo="0"
		     pro_role="SLAVE" pro_tmo="5" pro_try="1" pro="" pro_typ="0xD411" pro_fnc="[]"
		     pro_onparse="main.on_dash(exc);"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]"/>

		<!-- ================================================================
		     THE MODBUS TCP SERVER - registers at UR's addresses
		     ================================================================ -->
		<con id="CN_MB" xdb_fnc="[CON.tcp,PRO.modbus]" desc="Modbus TCP server (a real controller: 502)"
		     con_host="127.0.0.1" con_port="1504" con_mod="SERVER" pro_role="SLAVE" pro_mod="TCP"
		     con_acl="127.0.0.1"
		     con_way="FULL" con_ses="4" thr_wrk="1" con_clr="1" con_tmo="1.0" con_comdly="0"
		     con_rct="5" con_idletmo="0" con_keeptmo="0"
		     pro_tmo="1" pro_try="1" pro_typ="0xD411" pro="" pro_fnc="[]"
		     sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]" evt_thr="CN_MB"/>

		<!-- The <io>s are the registers: main writes their 'pro', the Modbus
		     server answers from it. An <io>'s pro_adr counts from its block. -->
		<dev id="UR" pro_slave_con="CN_MB" pro_slave_adr="1"
		     desc="the controller's Modbus server" sta="0x0303" sta_typ="0x1142" sta_fnc="[PRO.sta]">
			<bi id="B_GP" desc="general purpose registers 128..135"
			    sta="0x0303" sta_typ="0x1142" pro_typ="0xD412" pro="" pro_adr="128" pro_len="8">
				<io id="R128" pro="0" pro_typ="0x1102" pro_adr="0" sta="0x0303" sta_typ="0x1142" desc="cell: a part is ready at the pick position (1)"/>
				<io id="R129" pro="0" pro_typ="0x1102" pro_adr="1" sta="0x0303" sta_typ="0x1142" desc="robot: parts placed since power on"/>
				<io id="R130" pro="0" pro_typ="0x1102" pro_adr="2" sta="0x0303" sta_typ="0x1142" desc="robot: gripper closed (1)"/>
				<io id="R131" pro="0" pro_typ="0x1102" pro_adr="3" sta="0x0303" sta_typ="0x1142" desc="robot: part taken (1) - until the cell clears 128"/>
				<io id="R132" pro="100" pro_typ="0x1102" pro_adr="4" sta="0x0303" sta_typ="0x1142" desc="cell: speed, 10..100 %"/>
				<io id="R133" pro="0" pro_typ="0x1102" pro_adr="5" sta="0x0303" sta_typ="0x1142" desc="robot: program step"/>
				<io id="R134" pro="0" pro_typ="0x1102" pro_adr="6" sta="0x0303" sta_typ="0x1142" desc="free"/>
				<io id="R135" pro="0" pro_typ="0x1102" pro_adr="7" sta="0x0303" sta_typ="0x1142" desc="free"/>
			</bi>
			<bi id="B_Q" desc="joint positions 270..275, mrad"
			    sta="0x0303" sta_typ="0x1142" pro_typ="0xD412" pro="" pro_adr="270" pro_len="6">
				<io id="Q0" pro="0" pro_typ="0x1202" pro_adr="0" sta="0x0303" sta_typ="0x1142" desc="base"/>
				<io id="Q1" pro="0" pro_typ="0x1202" pro_adr="1" sta="0x0303" sta_typ="0x1142" desc="shoulder"/>
				<io id="Q2" pro="0" pro_typ="0x1202" pro_adr="2" sta="0x0303" sta_typ="0x1142" desc="elbow"/>
				<io id="Q3" pro="0" pro_typ="0x1202" pro_adr="3" sta="0x0303" sta_typ="0x1142" desc="wrist 1"/>
				<io id="Q4" pro="0" pro_typ="0x1202" pro_adr="4" sta="0x0303" sta_typ="0x1142" desc="wrist 2"/>
				<io id="Q5" pro="0" pro_typ="0x1202" pro_adr="5" sta="0x0303" sta_typ="0x1142" desc="wrist 3"/>
			</bi>
			<bi id="B_QD" desc="joint speeds 280..285, mrad/s"
			    sta="0x0303" sta_typ="0x1142" pro_typ="0xD412" pro="" pro_adr="280" pro_len="6">
				<io id="QD0" pro="0" pro_typ="0x1202" pro_adr="0" sta="0x0303" sta_typ="0x1142"/>
				<io id="QD1" pro="0" pro_typ="0x1202" pro_adr="1" sta="0x0303" sta_typ="0x1142"/>
				<io id="QD2" pro="0" pro_typ="0x1202" pro_adr="2" sta="0x0303" sta_typ="0x1142"/>
				<io id="QD3" pro="0" pro_typ="0x1202" pro_adr="3" sta="0x0303" sta_typ="0x1142"/>
				<io id="QD4" pro="0" pro_typ="0x1202" pro_adr="4" sta="0x0303" sta_typ="0x1142"/>
				<io id="QD5" pro="0" pro_typ="0x1202" pro_adr="5" sta="0x0303" sta_typ="0x1142"/>
			</bi>
			<bi id="B_TCP" desc="tool position 400..405: x y z 0.1 mm, rx ry rz mrad"
			    sta="0x0303" sta_typ="0x1142" pro_typ="0xD412" pro="" pro_adr="400" pro_len="6">
				<io id="TX"  pro="0" pro_typ="0x1202" pro_adr="0" sta="0x0303" sta_typ="0x1142"/>
				<io id="TY"  pro="0" pro_typ="0x1202" pro_adr="1" sta="0x0303" sta_typ="0x1142"/>
				<io id="TZ"  pro="0" pro_typ="0x1202" pro_adr="2" sta="0x0303" sta_typ="0x1142"/>
				<io id="TRX" pro="0" pro_typ="0x1202" pro_adr="3" sta="0x0303" sta_typ="0x1142"/>
				<io id="TRY" pro="0" pro_typ="0x1202" pro_adr="4" sta="0x0303" sta_typ="0x1142"/>
				<io id="TRZ" pro="0" pro_typ="0x1202" pro_adr="5" sta="0x0303" sta_typ="0x1142"/>
			</bi>
		</dev>

		<!-- the controller, twenty times a second: motion, program, registers -->
		<var id="T_STEP" xdb_fnc="[XDB.evt]" sta="0x0303" sta_typ="0x142" sta_fnc="[EVT.sta]"
		     evt="" evt_typ="0x5201" evt_thr="TH_ROB" evt_per="0.05" evt_dly="0" evt_syn="0"
		     evt_cfg="0x0042" evt_fnc="[main.step]" desc="the controller's step, 50 ms"/>

		<!-- ================================================================
		     THE CONTROLLER'S STATE
		     ================================================================ -->
		<var id="MODE"    sta="0x0303" val="POWER_OFF" val_typ="0x0401" desc="POWER_OFF, IDLE (powered, brakes on), RUNNING (brakes released)"/>
		<var id="SAFETY"  sta="0x0303" val="NORMAL"    val_typ="0x0401" desc="NORMAL, PROTECTIVE_STOP, SAFEGUARD_STOP"/>
		<var id="TRANS"   sta="0x0303" val="" val_typ="0x4401" desc="the power or brake step in progress: {to, at, then}, local"/>
		<!-- PSTOP_MS is NOT local (0x4...) on purpose: main.on_bump writes it,
		     and on_bump runs because the cell's page wrote BUMP through the
		     CELL's MQTT connection - into this document that is a remote
		     write, and a local attribute refuses a remote write, silently. -->
		<var id="PSTOP_MS" sta="0x0303" val="0" val_typ="0x0308" desc="when the protective stop happened"/>
		<var id="PROGRAM" sta="0x0303" val=""          val_typ="0x0401" desc="the loaded program"/>
		<var id="PSTATE"  sta="0x0303" val="STOPPED"   val_typ="0x0401" desc="STOPPED, PLAYING, PAUSED"/>
		<var id="PC"      sta="0x0303" val="0" val_typ="0x4104" desc="the step the program is at"/>
		<var id="STEP_MS" sta="0x0303" val="0" val_typ="0x4108" desc="when the step started (for waits)"/>
		<var id="GRIP"    sta="0x0303" val="0" val_typ="0x0104" desc="gripper: 1 closed"/>
		<var id="HOLDING" sta="0x0303" val="0" val_typ="0x0104" desc="1 = a part is in the gripper"/>
		<var id="PLACED"  sta="0x0303" val="0" val_typ="0x0104" desc="parts put down since power on (register 129)"/>

		<!-- the arm: joints and joint speeds in rad, the target of the move -->
		<var id="Q"      sta="0x0303" val="[0,-1.5708,0,-1.5708,0,0]" val_typ="0x0401" desc="joint positions, rad (UR home: upright)"/>
		<var id="QD"     sta="0x0303" val="[0,0,0,0,0,0]" val_typ="0x0401" desc="joint speeds, rad/s"/>
		<var id="TARGET" sta="0x0303" val=""  val_typ="0x4401" desc="the move in progress: joint target, rad, JSON"/>
		<var id="VCUR"   sta="0x0303" val="0"  val_typ="0x4308" desc="the lead joint's speed now, rad/s, local"/>
		<var id="VMAX"   sta="0x0303" val="60" val_typ="0x0308" val_unt="deg/s" desc="the fastest joint speed at 100 %"/>

		<!-- the gripper's waits and the dashboard greeting, per session -->
		<var id="GREETED" sta="0x0303" val="[0,0,0,0,0]" val_typ="0x4401" desc="dashboard sessions greeted, local"/>

		<!-- THE PROGRAMS. Waypoints in degrees; worked out once for a tool
		     pointing straight down (inverse kinematics, offline):
		       pick  x 0.40 y -0.30 z 0.07 m   place  x 0.40 y 0.30 z 0.09 m
		       '_above' is the same point 0.25 m high
		     The base goes to 201.4 rather than -158.6 on purpose: a movej
		     goes the short way only if the numbers say so. -->
		<var id="PROGRAMS" sta="0x0303" val_typ="0x0401" desc="the programs the controller has, as data"
		     val='{"pick_place.urp":[
 {"op":"movej","to":"ready"},
 {"op":"movej","to":"pick_above"},
 {"op":"wait_reg","reg":128,"val":1},
 {"op":"movej","to":"pick"},
 {"op":"grip","on":1},
 {"op":"wait","s":0.5},
 {"op":"set_reg","reg":131,"val":1},
 {"op":"movej","to":"pick_above"},
 {"op":"wait_reg","reg":128,"val":0},
 {"op":"set_reg","reg":131,"val":0},
 {"op":"movej","to":"place_above"},
 {"op":"movej","to":"place"},
 {"op":"grip","on":0},
 {"op":"wait","s":0.3},
 {"op":"count","reg":129},
 {"op":"movej","to":"place_above"},
 {"op":"goto","step":1}],
"home.urp":[{"op":"movej","to":"home"}]}'/>
		<var id="WAYPOINTS" sta="0x0303" val_typ="0x0401" desc="joint positions, degrees"
		     val='{"home":[0,-90,0,-90,0,0],
"ready":[162.8,-95.1,115.4,-110.3,-90,-107.2],
"pick_above":[127.7,-81,117.4,-126.4,-90,-142.3],
"pick":[127.7,-58.9,124.4,-155.5,-90,-142.3],
"place_above":[201.4,-81,117.4,-126.4,-90,-68.6],
"place":[201.4,-61.8,124.3,-152.4,-90,-68.6]}'/>

		<!-- ================================================================
		     THE WORLD - what the page may do to the robot (no xdb_acl)
		     ================================================================ -->
		<var id="DOOR" sta="0x0303" val="0" val_typ="0x1104" val_fnc="[main.on_door]" desc="the guard door: 1 open"/>
		<var id="BUMP" sta="0x0303" val="0" val_typ="0x1104" val_fnc="[main.on_bump]" desc="write 1: someone walks into the arm"/>
	</data>
</xdb>
