# Logs and databases are produced by running the examples
**/log/*.log
**/log/*.txt
**/log/*.db
**/log/*.db-journal
**/log/*.db-wal
**/log_archive/
# The record journal (rec_dir): PRJEDU_records
**/log/rec/

# Written by the engine beside the licence it used (last-seen time, host tolerance)
AyMON.lst
bin/lic/AyMON.lst
**/db/lic/AyMON.lst

# Written by Python when a script is imported
__pycache__/
*.pyc

# Debug symbols are not part of the distribution
bin/**/*.pdb

# Editor / OS noise
Thumbs.db
desktop.ini
*.swp
*~

# PRJEDU_opcua: made on the first run - certificates and private keys are
# per installation and never belong in a repository; so is the Python
# environment setup.bat / setup.sh builds, and OPC.gen's draft
**/db/pki/*.pem
**/sim/pki/
**/sim/.venv/
**/sim/.venv-linux/
**/log/*.xml

# PRJEDU_net: the shift reports it makes and uploads
**/out/

# PRJEDU_sites: what the host's page makes - its backups, and the roots it
# adds or restores (GAMMA, COPY). ACME and BETA are the example's own.
examples/hosting/PRJEDU_sites/backup/
examples/hosting/PRJEDU_sites/roots/*
!examples/hosting/PRJEDU_sites/roots/ACME/
!examples/hosting/PRJEDU_sites/roots/BETA/

# The documentation site, built by tools/site/build.py
tools/site/_build/
