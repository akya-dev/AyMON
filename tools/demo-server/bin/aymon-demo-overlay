#!/usr/bin/env python3
"""aymon-demo-overlay <project dir> <demo domain> <sessions> [ID:label ...]

What a public server needs and an example made for 127.0.0.1 does not have, applied to the
RUNNING copy (the repository's files are never touched; every reset applies it again):

  1. Sessions. A page's listeners carry small session lists (con_ses="4" on most live
     connections: the fifth page that opens gets 502 from nginx and no values). Every
     listener on this machine of PRO.http / PRO.mqtt / PRO.rest gets at least <sessions>.
     0 = leave them alone.
  2. Names. A root published as <label>.<domain> (PRJEDU_sites) gets that name added to
     its root_host; the local name stays, so the SSH tunnel still works.

Only start tags are edited, in place: comments, order and spacing stay as they were.
"""
import os, re, sys

prj, domain, sessions = sys.argv[1], sys.argv[2], int(sys.argv[3])
roots = [a.split(':', 1) for a in sys.argv[4:]]

CON = re.compile(r'<con\s[^>]*>', re.S)
def attr(tag, name):
    m = re.search(r'\s%s="([^"]*)"' % name, tag)
    return m.group(1) if m else None

def raise_sessions(tag):
    fnc = attr(tag, 'xdb_fnc') or ''
    if attr(tag, 'con_mod') != 'SERVER':
        return tag
    if not re.search(r'PRO\.(http|mqtt|rest)\b', fnc):
        return tag
    host = attr(tag, 'con_host') or ''
    if not (host.startswith('127.') or host.startswith('#') or host == 'localhost'):
        return tag                      # a listener not on this machine: not ours to size
    cur = attr(tag, 'con_ses')
    if cur is None or not cur.isdigit() or int(cur) >= sessions:
        return tag
    return re.sub(r'(\scon_ses=")\d+(")', r'\g<1>%d\2' % sessions, tag, count=1)

changed = []
for dp, dn, fn in os.walk(prj):
    for f in fn:
        if not f.endswith('.xml'):
            continue
        p = os.path.join(dp, f)
        with open(p, encoding='utf-8', newline='') as h:
            t = h.read()
        n = t
        if sessions > 0:
            n = CON.sub(lambda m: raise_sessions(m.group(0)), n)
        if os.path.normpath(p) == os.path.normpath(os.path.join(prj, 'db', 'AyXDB.xml')):
            for rid, label in roots:
                host = '%s.%s' % (label, domain)
                pat = re.compile(r'(<doc\s[^>]*\bid="%s"[^>]*\broot_host=")([^"]*)(")' % re.escape(rid), re.S)
                if not pat.search(n):
                    sys.exit('aymon-demo-overlay: %s: no <doc id="%s"> with root_host' % (p, rid))
                n = pat.sub(lambda m: m.group(1) + (m.group(2) if host in m.group(2) else m.group(2) + ', ' + host) + m.group(3), n, count=1)
        if n != t:
            with open(p, 'w', encoding='utf-8', newline='') as h:
                h.write(n)
            changed.append(os.path.relpath(p, prj))
print('overlay: %s' % (', '.join(changed) if changed else 'nothing to change'))
