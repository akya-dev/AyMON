# AyMON public demo -- settings. install.sh copies this file to /etc/aymon-demo/demo.env
# the first time; edit that copy, then run install.sh again.

# The demo's DNS name. The landing page is https://$DEMO_DOMAIN/, every example is
# https://<label>.$DEMO_DOMAIN/ (labels in examples.conf).
# DNS before you run install.sh: an A record (and AAAA if the server has IPv6) for
# $DEMO_DOMAIN and the same for *.$DEMO_DOMAIN, both to this server.
DEMO_DOMAIN=demo.example.com

# Who runs the server, one line on the landing page beside what the kit reads from the
# machine itself (cores, memory, system, engine version, each example's limits), so that a
# visitor knows what the speed of this box says and does not say. Empty = left out.
DEMO_HOST_NOTE="a rented virtual server (VPS)"

# Let's Encrypt: the account's e-mail (expiry notices) and your agreement to its Subscriber
# Agreement (https://letsencrypt.org/repository/). install.sh stops until this says yes.
ACME_EMAIL=you@example.com
ACME_AGREE_TOS=no

# letsencrypt = a real certificate (the server must answer on port 80 for every name);
# selfsigned  = a test box without public DNS (browsers warn).
TLS_MODE=letsencrypt

# Where the examples and the engine come from. A tag is better than a branch for a demo:
# the next install.sh run moves to whatever REF names now.
AYMON_REPO_URL=https://github.com/akya-dev/AyMON.git
AYMON_REPO_REF=main

# Every example goes back to the repository's copy (values, files, logs) this often.
RESET_HOURS=3

# The examples' pages listen with small session lists (most live connections: 4 pages at
# once, the fifth gets no values). The running copies get at least this many; 0 = as shipped.
LIVE_SESSIONS=32

# The account you log in with over SSH. install.sh turns password logins off and refuses
# to do so unless this account (or root) has a key in ~/.ssh/authorized_keys.
ADMIN_USER=debian

# 1 = leave SSH, the firewall and fail2ban alone (you manage them yourself).
SKIP_HOST_HARDENING=0
