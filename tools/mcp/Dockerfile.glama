# AyMON's MCP endpoint in a container, as Glama (glama.ai/mcp/servers) checks MCP servers:
# mcp-proxy starts a stdio server and serves it over HTTP / SSE; the stdio server is
# tools/mcp/aymon_mcp_stdio.py, which starts the PRJEDU_mcp example (a simulated tank
# plant, nothing outside the container) and bridges stdio to the engine's MCP endpoint.
#
# Build from the repository root:   docker build -f tools/mcp/Dockerfile.glama -t aymon-mcp .
# Run:                               docker run --rm -p 8080:8080 aymon-mcp
#                                    -> http://localhost:8080/mcp (and /sse)
# The read-only endpoint instead:    -e AYMON_MCP_URL=http://127.0.0.1:8095/mcp -e AYMON_MCP_KEY=demo-read-key
#
# The engine is the Linux build in bin/ (x86-64 or arm64, picked by run.sh); it needs
# OpenSSL 3 from the system and nothing else. The example's education licence is in bin/lic.
FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates curl gnupg libssl3 python3 \
 && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
 && apt-get install -y --no-install-recommends nodejs \
 && npm install -g mcp-proxy@6.10.0 \
 && apt-get purge -y gnupg && apt-get autoremove -y \
 && apt-get clean && rm -rf /var/lib/apt/lists/* /tmp/* /root/.npm

WORKDIR /app
COPY . .

CMD ["mcp-proxy", "--", "python3", "tools/mcp/aymon_mcp_stdio.py", "--start", "examples/ai-vision/PRJEDU_mcp/run.sh"]
