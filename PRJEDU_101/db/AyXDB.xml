<?xml version="1.0" encoding="utf-8" standalone="no"?>
<!-- =====================================================================
     PRJEDU_101 - AyMON example project 1: "first steps"
     No network, no database, no hardware. Everything in this example runs
     on any machine that can start AyXDB.exe.

     THE ROOT DOCUMENT. Every AyMON installation starts with one file like
     this one. It does two things and nothing else:
       * it names the engine (id, log file, log level, starting state)
       * it lists the CHILD DOCUMENTS to load, in order

     The real work lives in the child documents. Splitting a plant into
     documents is how AyMON keeps a large site readable - one document per
     building, per line, per function.

     Path macros: %PRJ% = this project directory, %DB% = this db directory.
     Run:  run.bat          (or AyXDB.exe -console <path to this file>)
     ===================================================================== -->
<xdb id="XDB" xdb_lib="AyPRO" xdb_log="4" log_cfg="0x39C0" log_lnk="%PRJ%/log/XDB.log"
     sta="0x0300" tid="S01">
	<config>
		<doc id="EDU/S00" sta="0x0300" src="%DB%/db_EDU.xml" desc="first steps - timers, scripts, alarms" />
	</config>
	<data>
	</data>
</xdb>
